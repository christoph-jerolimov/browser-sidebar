{
  "manifest_version": 3,
  "name": "Docs Ticket Sidebar",
  "version": "1.0.0",
  "description": "Follows your selection/cursor in Google Docs, detects Jira keys and GitHub links, and shows details in the side panel.",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Docs Ticket Sidebar",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidebar/panel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/document/*"],
      "js": ["matcher.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
