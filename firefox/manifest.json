{
  "manifest_version": 2,
  "name": "Docs Ticket Sidebar",
  "version": "1.0.0",
  "description": "Follows your selection/cursor in Google Docs, detects Jira keys and GitHub links, and shows details in the sidebar.",
  "permissions": ["storage", "https://*/*"],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_title": "Toggle Docs Ticket Sidebar",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "sidebar_action": {
    "default_title": "Ticket Sidebar",
    "default_panel": "sidebar/panel.html",
    "default_icon": "icons/icon48.png"
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/document/*"],
      "js": ["matcher.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "docs-ticket-sidebar@jerolimov.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
